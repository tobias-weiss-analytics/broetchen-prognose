/* ---------- Base ---------- */
* {
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  font-size: 10pt;
}

/* Window / Dialog */
QMainWindow, QWidget {
  background: #1e1f22;
  color: #e6e6e6;
}

/* Group boxes & frames */
QGroupBox {
  border: 1px solid #2b2d31;
  border-radius: 8px;
  margin-top: 12px;
  padding: 10px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #9aa3af;
}

/* Labels */
QLabel { color: #e6e6e6; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox, QTimeEdit {
  background: #2b2d31;
  color: #e6e6e6;
  border: 1px solid #3a3d42;
  border-radius: 6px;
  padding: 6px 8px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QComboBox:focus, QTimeEdit:focus { border: 1px solid #4f46e5; }

/* Buttons (linke Sidebar + allgemein) */
QPushButton {
  background: #2b2d31;
  color: #e6e6e6;
  border: 1px solid #3a3d42;
  border-radius: 10px;
  padding: 10px 12px;
  text-align: left;
}
QPushButton:hover { background: #34373d; }
QPushButton:pressed { background: #3d4150; }
QPushButton:disabled { color: #7b7f86; border-color: #2a2d31; }

/* Primary */
QPushButton[variant="primary"] {
  background: #4f46e5;
  border: 1px solid #4f46e5;
  color: white;
}
QPushButton[variant="primary"]:hover { background: #5b54ff; }

/* Checkbox */
QCheckBox { color: #e6e6e6; spacing: 8px; }
QCheckBox::indicator {
  width: 18px; height: 18px;
  border-radius: 4px;
  border: 1px solid #3a3d42;
  background: #2b2d31;
}
QCheckBox::indicator:checked { background: #4f46e5; border-color: #4f46e5; }

/* Listen (Store-Auswahl) */
QListWidget, QListView {
  background: #2b2d31;
  color: #e6e6e6;
  border: 1px solid #3a3d42;
  border-radius: 8px;
  padding: 6px;
}
QListView::item { padding: 6px 8px; }
QListView::item:selected { background: #404455; }

/* Tabellen/Log */
QTableView, QTableWidget {
  background: #1b1c1f;
  alternate-background-color: #222428;
  color: #e6e6e6;
  border: 1px solid #2b2d31;
  gridline-color: #2f3338;
  selection-background-color: #404455;
  selection-color: #ffffff;
}
QTableView::indicator, QListView::indicator {
  width: 16px; height: 16px;
  border-radius: 4px;
  border: 1px solid #5a5f69;
  background: #2b2d31;
}
QTableView::indicator:checked, QListView::indicator:checked {
  background: #4f46e5; border-color: #4f46e5;
}
QTableCornerButton::section { background: #23252a; border: none; }
QHeaderView::section {
  background: #23252a;
  color: #d7dae0;
  padding: 6px;
  border: none;
}
QPlainTextEdit, QTextEdit {
  background: #17181b;
  color: #e6e6e6;
  border: 1px solid #2b2d31;
  border-radius: 8px;
  padding: 8px;
}

/* Splitter */
QSplitter::handle { background: #181a1d; width: 4px; }

/* Scrollbar */
QScrollBar:vertical, QScrollBar:horizontal { background: #1e1f22; border: none; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #32353b; border-radius: 6px; min-height: 24px; min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
/* Tabs */
QTabWidget::pane { border: 1px solid #2b2d31; border-radius: 6px; top: -1px; }
QTabBar::tab {
  background: #23252a; color: #9aa3af;
  padding: 7px 16px; border: 1px solid #2b2d31; border-bottom: none;
  border-top-left-radius: 6px; border-top-right-radius: 6px; margin-right: 2px;
}
QTabBar::tab:selected { background: #1e1f22; color: #e6e6e6; }
QTabBar::tab:hover { color: #e6e6e6; }

/* Statusleiste, Menü */
QStatusBar { color: #9aa3af; }
QMenuBar { background: #1e1f22; }
QMenuBar::item:selected, QMenu::item:selected { background: #404455; }
QMenu { background: #2b2d31; border: 1px solid #3a3d42; }
QProgressBar { border: 1px solid #3a3d42; border-radius: 4px; background: #2b2d31; height: 10px; }
QProgressBar::chunk { background: #4f46e5; }
QScrollArea { border: none; }
